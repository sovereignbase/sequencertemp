{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/sequencertemp",
  "version": "0.0.0",
  "description": "Temporary TypeScript choco scaffold for documenting and conceptualizing the design with reduced cognitive load.",
  "keywords": [
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:convergence": "vitest run test/convergence --coverage.enabled=false",
    "test:stress": "vitest run test/stress --coverage.enabled=false",
    "test:e2e": "playwright test",
    "bench": "npm run build:package && node benchmark/index.ts",
    "bench:lifecycle": "npm run bench -- --suite lifecycle",
    "bench:throughput": "npm run bench -- --suite throughput",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/sequencertemp.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/sequencertemp/issues"
  },
  "homepage": "https://sovereignbase.dev/sequencertemp"
}
